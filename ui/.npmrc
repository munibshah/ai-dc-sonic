# Disable the implicit deps re-verification that runs before every `pnpm <script>`.
# It was failing on this remote because pnpm 11 treats ignored build scripts
# (sharp's vips compile) as a hard error during the pre-run check, even though
# sharp's prebuilt binary is fine for our use case. We approve it in package.json
# under "pnpm.onlyBuiltDependencies"; this flag just stops the auto-recheck.
verify-deps-before-run=false
